# Copy this file to ".env" (same folder) and put your key after the equals sign.
# ".env" is git-ignored: never commit it, never post it.
# The key is used when the sidebar key box is empty, and by eval_t2s.py / rag.py. A key typed in the sidebar replaces it for that session.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
